# Copy to infra/.env (gitignored) and fill in; never commit the real file.
# `make backend` loads it, and Compose reads POSTGRES_PASSWORD from it.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Long random values, e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=
LLLM_SECRET_KEY=

# The Jupyter server's token and SearXNG's secret. `make backend` generates
# both (openssl rand -hex 32) when they are missing, so these can stay empty.
JUPYTER_TOKEN=
SEARXNG_SECRET=
