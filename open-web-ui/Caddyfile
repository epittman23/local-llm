# Fronts both Open WebUI and the llama-web dashboard on one port (4000),
# routing by path. See docker-compose.yml and CLAUDE.md's decisions log
# (2026-09-06) for why this exists instead of a Function/Pipe living inside
# Open WebUI, or a fork of it.
:4000 {
	# The dashboard lives under /ops and is a *host* process (llama-web,
	# scripts/llama-env.sh), not a container -- it manages real host process
	# groups against the actual GPU. From inside the caddy container,
	# `localhost` means the caddy container itself; host.docker.internal is
	# what reaches the host (see the extra_hosts entry in docker-compose.yml).
	#
	# `handle`, not `handle_path`: the path is forwarded unchanged, because
	# llama_web.py itself mounts its app under /ops (see scripts/llama_web.py).
	# So http://localhost:8095/ops/... during development and
	# http://localhost:4000/ops/... through this proxy hit the identical route.
	#
	# Both `/ops` and `/ops/*` are named here on purpose, not just `/ops/*`:
	# Caddy's path matcher requires the slash to be present, so a bare `/ops`
	# (no trailing slash -- the exact URL this repo's own docs and the
	# dashboard-link userscript use) does not match `/ops/*` alone and would
	# silently fall through to the catch-all Open WebUI handler below. `handle`
	# itself only takes one path argument, so the two are named in a matcher.
	@dashboard path /ops /ops/*
	handle @dashboard {
		reverse_proxy host.docker.internal:{$LLAMA_WEB_PORT:8095}
	}

	# Everything else is Open WebUI, completely path-unaware on purpose: its
	# own static asset references are root-relative, so it is the proxy's job
	# to stay out of its way, not the other way around. Caddy's reverse_proxy
	# auto-detects Upgrade/Connection headers, so Open WebUI's Socket.IO
	# traffic gets WebSocket passthrough with no extra directive here.
	handle {
		reverse_proxy open-webui:8080
	}
}
