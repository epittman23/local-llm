---
import '@/styles/global.css';

interface Props {
	title?: string;
}

const { title = 'local-llm' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<!-- lib/theme.ts keeps this at the page colour of the current theme. -->
		<meta name="theme-color" content="#121916" />
		<title>{title}</title>
		<script is:inline>
			// Anti-FOUC: set before first paint, mirroring d863707:apps/openwebui/src/app.html's
			// own inline script (same localStorage.theme key, same class-on-<html>
			// mechanism) so a shared cookie/localStorage-free preference isn't needed
			// yet -- ports the mechanism now, not the theme picker UI (that's Phase 4).
			(() => {
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				// 'dark' is lib/theme.ts's DEFAULT_THEME: a browser that never chose is dark.
				const theme = localStorage.theme || 'dark';
				// Same mapping as lib/theme.ts's themeClasses (OLED dark is `dark oled`).
				const classes = theme === 'oled-dark' ? ['dark', 'oled'] : theme === 'dark' ? ['dark'] : theme === 'light' ? ['light'] : [prefersDark ? 'dark' : 'light'];
				document.documentElement.classList.add(...classes);
				// --page in each theme (styles/standard.css), as lib/theme.ts's applyTheme sets it.
				document
					.querySelector('meta[name="theme-color"]')
					?.setAttribute('content', classes.includes('oled') ? '#000000' : classes.includes('dark') ? '#121916' : '#f8f7f2');
			})();
		</script>
	</head>
	<body>
		<!--
			The boot splash (STA-2, WRD-3): the product's name on the page colour,
			drawn before any script runs, so a slow start never shows a blank or
			bare "Loading…" page. The spinner waits 400 ms. RootLayout removes it once
			React has drawn; while the session is still loading, AppShell's BootSplash
			continues it with the same look.
		-->
		<div
			id="boot-splash"
			class="bg-page text-foreground fixed inset-0 z-50 flex flex-col items-center justify-center gap-4 p-4 text-center"
		>
			<p class="text-title font-title">local-llm</p>
			<div class="boot-splash-spinner flex size-5 items-center justify-center" aria-hidden="true">
				<svg
					class="size-5 animate-spin"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg
				>
			</div>
			<p class="min-h-5"></p>
		</div>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Updated at runtime by the UI-scale control once it exists (Phase 4);
		   see d863707:apps/openwebui/src/app.css's own --app-text-scale for the
		   original. Every consumer reads it with a `1` fallback, so it is
		   safe to declare here before anything sets it. */
		--app-text-scale: 1;
	}

	/* The boot splash's spinner appears after 400 ms (BootSplash.tsx's SPINNER_AFTER_MS). */
	.boot-splash-spinner {
		opacity: 0;
		animation: boot-splash-appear 1ms linear 400ms forwards;
	}
	@keyframes boot-splash-appear {
		to {
			opacity: 1;
		}
	}
</style>
